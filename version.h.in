/**
 * @file version.h
 * @brief Build-time version information (auto-generated by CMake)
 *
 * Generated from version.h.in — do NOT edit manually.
 */

#ifndef VERSION_H
#define VERSION_H

/* ---- Product identity ---- */
#define APP_NAME         "@PRODUCT_NAME@"
#define APP_VERSION      "@PRODUCT_VERSION@"        /* e.g. 1.1.0            */
#define APP_VERSION_MAJOR @VERSION_MAJOR@
#define APP_VERSION_MINOR @VERSION_MINOR@
#define APP_VERSION_PATCH @VERSION_PATCH@
#define APP_BUILD_TIME   "@BUILD_TIME@"             /* e.g. 2605301230       */
#define APP_BUILD_TYPE   "@BUILD_TYPE@"             /* alpha / beta / release */

/* Full tag: APP-1.1.0.2605301230_alpha */
#define APP_FULL_TAG     "@FULL_TAG@"

/* Git commit hash (8-char short) — traceability */
#define APP_GIT_HASH     "@GIT_HASH@"

/* Convenience string for logging */
#define APP_VERSION_STRING  APP_NAME "-" APP_VERSION "." APP_BUILD_TIME "_" APP_BUILD_TYPE

#endif /* VERSION_H */
